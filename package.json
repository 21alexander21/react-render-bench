{
  "name": "react-render-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "check": "biome check . && tsc --project tsconfig.json",
