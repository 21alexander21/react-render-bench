{
  "name": "react-render-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "build": "corepack pnpm --recursive --filter './apps/*' build",
    "check": "biome check . && corepack pnpm typecheck",
    "dev": "corepack pnpm --parallel --filter './apps/*' dev",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "corepack pnpm --recursive test",
    "typecheck": "tsc --project tsconfig.json && corepack pnpm --recursive --filter './packages/*' typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "typescript": "7.0.2"
  }
}
